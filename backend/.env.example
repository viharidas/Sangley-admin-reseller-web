# MongoDB connection string (e.g. a MongoDB Atlas connection string).
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net
DB_NAME=sangley

# Comma-separated list of allowed frontend origins (used for CORS).
SANGLEY_TRUSTED_ORIGINS=https://your-frontend.vercel.app

# Secret used to sign/verify JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Bootstrap admin account credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Fernet key used to encrypt/decrypt reseller-portal data at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PORTAL_DATA_KEY=

# Public URL of the deployed frontend (used to build referral links).
FRONTEND_URL=https://your-frontend.vercel.app

# Name/namespace used when building storage object paths.
STORAGE_APP_NAME=sangley

# Optional: only needed if you keep using Emergent's object-storage proxy for
# reseller-portal file uploads (backend/portal/files.py). Leave blank to
# disable that feature — uploads will return 503 until you wire up your own
# storage backend.
INTEGRATION_PROXY_URL=
EMERGENT_LLM_KEY=
